diff --git a/runtime/vm/bytecode_reader.cc b/runtime/vm/bytecode_reader.cc
index 16fcc57fcd37f76ca9a8f607763f423f4d06ca5a..a38d94fae5e16d7c9936c65ef17df60d390a4a8f 100644
--- a/runtime/vm/bytecode_reader.cc
+++ b/runtime/vm/bytecode_reader.cc
@@ -1202,12 +1202,9 @@ ObjectPtr BytecodeReaderHelper::ReadObjectContents(uint32_t header) {
           return thread_->bytecode_loader()->GetExpressionEvaluationFunction();
         }
         FunctionPtr function = Function::null();
-        ErrorPtr finalize_err = is_constructor
-                                    ? cls.EnsureIsAllocateFinalized(thread_)
-                                    : cls.EnsureIsFinalized(thread_);
+        ErrorPtr finalize_err = cls.EnsureIsFinalized(thread_);
         if (finalize_err != Error::null()) {
-          FATAL("Unable to finalize class %s%s: %s", cls.ToCString(),
-                is_constructor ? "" : " for allocation",
+          FATAL("Unable to finalize class %s: %s", cls.ToCString(),
                 Error::Handle(Z, finalize_err).ToErrorCString());
         }
         function = Resolver::ResolveFunction(Z, cls, name);
@@ -1227,6 +1224,19 @@ ObjectPtr BytecodeReaderHelper::ReadObjectContents(uint32_t header) {
           FATAL("Unable to find function %s in %s", name.ToCString(),
                 cls.ToCString());
         }
+        // Only a generative constructor allocates an instance of its own
+        // class, so only that case needs the class to be allocate-finalized.
+        // A factory allocates something else -- Uint8List.fromList returns a
+        // _Uint8List -- and requiring Uint8List itself to be allocate-finalized
+        // rejects modules whose host snapshot can run them perfectly well.
+        if (is_constructor && !Function::Handle(Z, function).IsFactory()) {
+          finalize_err = cls.EnsureIsAllocateFinalized(thread_);
+          if (finalize_err != Error::null()) {
+            FATAL("Unable to finalize class %s for allocation: %s",
+                  cls.ToCString(),
+                  Error::Handle(Z, finalize_err).ToErrorCString());
+          }
+        }
         return function;
       }
     }
