+namespace {
+
+// A patch module names its libraries package:patch.<seq>.<package>/...; the
+// host's own library is package:<package>/....
+std::string PatcherHostLibrary(const std::string& library) {
+  static const std::string kPrefix = "package:patch.";
+  if (library.compare(0, kPrefix.size(), kPrefix) != 0) {
+    return library;
+  }
+  size_t end = kPrefix.size();
+  while (end < library.size() && library[end] >= '0' && library[end] <= '9') {
+    end++;
+  }
+  if (end == kPrefix.size() || end + 1 >= library.size() ||
+      library[end] != '.') {
+    return library;
+  }
+  return "package:" + library.substr(end + 1);
+}
+
+// A top-level declaration of the root library, or null when it has none.
+Dart_Handle PatcherRootField(const char* name) {
+  Dart_Handle root = Dart_RootLibrary();
+  if (Dart_IsError(root) || Dart_IsNull(root)) {
+    return Dart_Null();
+  }
+  Dart_Handle value = Dart_GetField(root, ToDart(name));
+  return Dart_IsError(value) ? Dart_Null() : value;
+}
+
+bool IsFound(Dart_Handle handle) {
+  return !Dart_IsError(handle) && !Dart_IsNull(handle);
+}
+
+}  // namespace
+
+Dart_Handle DartCallbackCache::LookupPatchedClosure(
+    const std::string& name,
+    const std::string& class_name,
+    const std::string& library_path,
+    bool start) {
+  Dart_Handle found = LookupDartClosure(name, class_name, library_path);
+  Dart_Handle hook = PatcherRootField("flutterPatcherEntry");
+  if (!Dart_IsClosure(hook)) {
+    return found;
+  }
+  // Keys name the host's declaration: a callback registered by patched code
+  // names its module library, which another isolate may not have loaded.
+  std::string library = PatcherHostLibrary(library_path);
+  if (library.empty()) {
+    // The root library is the generated bootstrap; the app's own entry
+    // library declares the app's entry points.
+    Dart_Handle app = PatcherRootField("flutterPatcherAppLibrary");
+    if (Dart_IsString(app)) {
+      library = tonic::StdStringFromDart(app);
+    }
+  }
+  if (!IsFound(found) && !library.empty() && library != library_path) {
+    found = LookupDartClosure(name, class_name, library);
+  }
+  std::string key =
+      library + "#" + (class_name.empty() ? name : class_name + "." + name);
+  Dart_Handle args[] = {ToDart(key), IsFound(found) ? found : Dart_Null(),
+                        ToDart(start)};
+  Dart_Handle chosen = Dart_InvokeClosure(hook, 3, args);
+  if (Dart_IsError(chosen)) {
+    FML_LOG(ERROR) << "flutterPatcherEntry failed for " << key << ": "
+                   << Dart_GetError(chosen);
+    return found;
+  }
+  return Dart_IsNull(chosen) ? found : chosen;
+}
+
 }  // namespace flutter
