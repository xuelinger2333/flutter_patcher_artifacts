+            false,
+            "Call the only precompiled implementation of a member that a "
+            "dynamic module may override directly when the receiver is of "
+            "a precompiled class.");
+
+void AotCallSpecializer::GuardSingleTargetCalls() {
+  if (!FLAG_guard_single_target_calls) return;
+  if (!isolate_group()->has_dynamically_extendable_classes()) return;
+  ASSERT(current_iterator_ == nullptr);
+  const intptr_t max_block_id = flow_graph()->max_block_id();
+  for (BlockIterator block_it = flow_graph()->reverse_postorder_iterator();
+       !block_it.Done(); block_it.Advance()) {
+    ForwardInstructionIterator it(block_it.Current());
+    current_iterator_ = &it;
+    while (!it.Done()) {
+      Instruction* instr = it.Current();
+      if (!it.Done()) it.Advance();
+      InstanceCallInstr* call = instr->AsInstanceCall();
+      if (call == nullptr) continue;
+      const Function& interface_target = call->interface_target();
+      if (interface_target.IsNull()) continue;
+      {
+        // Already the slow path of an earlier guard.
+        BlockEntryInstr* block = call->GetBlock();
+        if (block->PredecessorCount() == 1) {
+          BranchInstr* branch =
+              block->PredecessorAt(0)->last_instruction()->AsBranch();
+          if (branch != nullptr && branch->condition()->IsTestRange()) {
+            continue;
+          }
+        }
+      }
+      const Function* target =
+          precompiler_->selector_map()->SingleTarget(interface_target);
+      if (target == nullptr || target->is_polymorphic_target()) continue;
+      Value* receiver = call->ArgumentValueAt(call->FirstArgIndex());
+      if (receiver->Type()->is_nullable()) continue;
+      if (call->CanReceiverBeSmiBasedOnInterfaceTarget(Z)) continue;
+      // A generic call passes its type arguments first; FromCall keeps them,
+      // and the target has the type parameters of the interface target.
+      auto load_cid = new (Z) LoadClassIdInstr(receiver->CopyWithType(Z),
+                                               kUnboxedUword, false);
+      InsertBefore(call, load_cid, call->env(), FlowGraph::kValue);
+      StaticCallInstr* fast =
+          StaticCallInstr::FromCall(Z, call, *target, call->CallCount());
+      ReplaceWithConditionalCall(call, load_cid, fast);
+    }
+    current_iterator_ = nullptr;
+  }
+  if (flow_graph()->max_block_id() != max_block_id) {
+    flow_graph()->DiscoverBlocks();
+  }
+}
