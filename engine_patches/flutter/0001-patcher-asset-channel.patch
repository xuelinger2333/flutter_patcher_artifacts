+// flutter_patcher: assets of an authenticated patch, installed by the app
+// before runApp and consulted before the application bundle, so rootBundle,
+// images, fonts and shaders all see the patched bytes.
+class PatcherAssetResolver final : public AssetResolver {
+ public:
+  using Assets = std::map<std::string, std::shared_ptr<std::vector<uint8_t>>>;
+
+  explicit PatcherAssetResolver(Assets assets) : assets_(std::move(assets)) {}
+
+  bool IsValid() const override { return true; }
+
+  bool IsValidAfterAssetManagerChange() const override { return true; }
+
+  // A type no embedder replaces through UpdateResolverByType.
+  AssetResolverType GetType() const override { return kAssetManager; }
+
+  std::unique_ptr<fml::Mapping> GetAsMapping(
+      const std::string& asset_name) const override {
+    auto found = assets_.find(asset_name);
+    if (found == assets_.end()) {
+      return nullptr;
+    }
+    std::shared_ptr<std::vector<uint8_t>> bytes = found->second;
+    return std::make_unique<fml::NonOwnedMapping>(
+        bytes->data(), bytes->size(), [bytes](const uint8_t*, size_t) {});
+  }
+
+  bool operator==(const AssetResolver& other) const override {
+    return this == &other;
+  }
+
+ private:
+  const Assets assets_;
+};
+
+// u32 count, then per asset: u32 key size, key, u32 byte size, bytes; all
+// little-endian. Keys are unique and nonempty, and nothing may follow.
+bool ParsePatcherAssets(const fml::Mapping& data,
+                        PatcherAssetResolver::Assets* assets) {
+  const uint8_t* cursor = data.GetMapping();
+  size_t left = data.GetSize();
+  auto read_u32 = [&](uint32_t* value) {
+    if (left < 4) {
+      return false;
+    }
+    *value = static_cast<uint32_t>(cursor[0]) |
+             static_cast<uint32_t>(cursor[1]) << 8 |
+             static_cast<uint32_t>(cursor[2]) << 16 |
+             static_cast<uint32_t>(cursor[3]) << 24;
+    cursor += 4;
+    left -= 4;
+    return true;
+  };
+  uint32_t count = 0;
+  if (!read_u32(&count)) {
+    return false;
+  }
+  for (uint32_t i = 0; i < count; i++) {
+    uint32_t key_size = 0;
+    if (!read_u32(&key_size) || key_size == 0 || key_size > left) {
+      return false;
+    }
+    std::string key(reinterpret_cast<const char*>(cursor), key_size);
+    cursor += key_size;
+    left -= key_size;
+    uint32_t size = 0;
+    if (!read_u32(&size) || size > left) {
+      return false;
+    }
+    auto bytes = std::make_shared<std::vector<uint8_t>>(cursor, cursor + size);
+    cursor += size;
+    left -= size;
+    if (!assets->emplace(std::move(key), std::move(bytes)).second) {
+      return false;
+    }
+  }
+  return left == 0;
+}
