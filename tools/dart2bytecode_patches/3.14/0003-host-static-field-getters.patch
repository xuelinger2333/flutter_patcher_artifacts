+  // A static field of a library the host loaded from Kernel has the getter
+  // the VM gave it there: none only when the initializer is a literal
+  // (SimpleExpressionConverter::IsSimple in runtime/vm/kernel_loader.cc). A
+  // constant that is not written as one, such as a reference to a const
+  // variable, leaves the field lazily initialized through its getter.
+  bool _hostInitializesLazily(Field field) {
+    final initializer = field.initializer;
+    return initializer != null &&
+        !(initializer is StringLiteral ||
+            initializer is BoolLiteral ||
+            initializer is IntLiteral ||
+            initializer is DoubleLiteral ||
+            initializer is NullLiteral);
+  }
